{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/plan.schema.json",
  "title": "Orchestration Plan",
  "type": "object",
  "required": ["version", "planId", "taskId", "status", "goal", "steps", "createdAt"],
  "properties": {
    "version": {"const": 1},
    "planId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "taskAuthorityHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "policyVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "hostSessionId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]+$"},
    "planSubjectVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "planSubjectHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "creationRequestHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "approvalRef": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "status": {"enum": ["DRAFT", "AWAITING_CONFIRMATION", "APPROVED", "EXECUTING", "COMPLETED", "FAILED", "CANCELLED"]},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2048},
    "steps": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/planStep"}},
    "createdAt": {"type": "string", "format": "date-time"},
    "confirmedAt": {"type": "string", "format": "date-time"},
    "cancelledAt": {"type": "string", "format": "date-time"},
    "cancellationReasonHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failureReasonHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "planStep": {
      "type": "object",
      "required": ["stepId", "role", "goal", "tools", "readScope", "writes", "status"],
      "properties": {
        "stepId": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"type": "string", "minLength": 1, "maxLength": 128},
        "goal": {"type": "string", "minLength": 1, "maxLength": 2048},
        "tools": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000\\r\\n]+$"}, "uniqueItems": true},
        "readScope": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000\\r\\n]+$"}},
        "writes": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/writeIntent"}},
        "dependsOn": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "evidenceRefs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "leaseRefs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
        "failureReasonHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "status": {"enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED"]}
      },
      "additionalProperties": false
    },
    "writeIntent": {
      "type": "object",
      "required": ["target", "action", "purpose"],
      "properties": {
        "target": {"type": "string", "minLength": 1, "maxLength": 512},
        "action": {"enum": ["create", "modify", "delete"]},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
