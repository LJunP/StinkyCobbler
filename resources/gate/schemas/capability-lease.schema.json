{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/capability-lease.schema.json",
  "title": "Capability Lease",
  "type": "object",
  "required": [
    "id",
    "taskId",
    "agentId",
    "role",
    "capability",
    "level",
    "workspace",
    "readScope",
    "writeSet",
    "issuedAt",
    "expiresAt",
    "maxToolCalls",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "readScope": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "writeSet": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "allowedCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedDestinations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvalRefs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "policyVersion": {
      "type": "string"
    },
    "issuedBy": {
      "type": "string"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxToolCalls": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "expired"
      ]
    },
    "revokedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revocationReasonHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{12}(?:-[a-f0-9]{12}){4}-[a-f0-9]{4}$"
    },
    "subtaskRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "subtaskAttempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "planRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "stepRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "planGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "parentGrantRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskAuthorityHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "hostSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {"required": ["planRef"]},
          {"required": ["stepRef"]},
          {"required": ["planGeneration"]}
        ]
      },
      "then": {
        "required": ["planRef", "stepRef", "planGeneration"],
        "not": {"required": ["subtaskRef"]}
      }
    }
    ,
    {
      "if": { "required": ["subtaskAttempt"] },
      "then": {
        "required": ["subtaskRef"],
        "not": {
          "anyOf": [
            { "required": ["planRef"] },
            { "required": ["stepRef"] },
            { "required": ["planGeneration"] }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
