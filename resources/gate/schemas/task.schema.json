{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/task.schema.json",
  "title": "Stinky Cobbler Task Charter",
  "type": "object",
  "required": ["id", "workspaceId", "goal", "requestedOutputs", "riskLevel", "state"],
  "properties": {
    "id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "workspaceId": {"type": "string", "minLength": 1, "maxLength": 256},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2048},
    "nonGoals": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
    "scope": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 512}},
    "inputs": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
    "requestedOutputs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
    "acceptanceCriteria": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
    "stopConditions": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
    "constraints": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
    "riskNotes": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
    "dataClassification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "riskLevel": {"enum": ["L0", "L1", "L2", "L3"]},
    "state": {"enum": ["DRAFT", "SCOPED", "DESIGNED", "APPROVED_FOR_EXECUTION", "RUNNING", "REVIEWING", "VERIFYING", "AWAITING_APPROVAL", "ARCHIVED", "DONE", "BLOCKED", "REWORK", "CANCELLED"]},
    "authorityGeneration": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "profile": {"type": "string", "maxLength": 128},
    "packs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
    "writeSet": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512}},
    "approvalRequired": {"type": "boolean"},
    "approvalRefs": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 128}},
    "completionReceiptRef": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "completionEvidenceRefs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}
  },
  "additionalProperties": false
}
