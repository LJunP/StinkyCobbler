{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/specialists-policy.schema.json",
  "title": "Tiered Specialists Policy Layer",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "specialists": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/specialist" }
    }
  },
  "$defs": {
    "singleLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "specialist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "title", "instructions", "acceptanceChecklist", "negativeRules", "suggestedCapabilities"],
      "properties": {
        "domain": { "allOf": [{ "$ref": "#/$defs/singleLine" }, { "maxLength": 64 }] },
        "title": { "allOf": [{ "$ref": "#/$defs/singleLine" }, { "maxLength": 128 }] },
        "instructions": { "$ref": "#/$defs/instructionList" },
        "acceptanceChecklist": { "$ref": "#/$defs/instructionList" },
        "negativeRules": { "$ref": "#/$defs/instructionList" },
        "suggestedCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": ["repository-read", "git-read", "docs-index", "repository-write"]
          }
        }
      }
    },
    "instructionList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/singleLine" }
    }
  }
}
