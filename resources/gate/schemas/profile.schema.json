{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://stinkycobbler.dev/schemas/profile.schema.json",
  "type":"object",
  "required":["version","id","label","defaultAutomation","enabledPacks"],
  "properties":{
    "version":{"type":"integer","const":1},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},
    "label":{"type":"string","minLength":1},
    "defaultAutomation":{"enum":["draft-first","reviewed-workflow","policy-governed","advice-only"]},
    "enabledPacks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"}}
  },
  "additionalProperties":false
}
