{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/contract-templates-policy.schema.json",
  "title": "Tiered Contract Templates Policy Layer",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "templates": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/contractTemplate" }
    }
  },
  "$defs": {
    "singleLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "contractTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "domain", "goal", "criteria", "scope"],
      "properties": {
        "name": { "allOf": [{ "$ref": "#/$defs/singleLine" }, { "maxLength": 128 }] },
        "description": { "$ref": "#/$defs/singleLine" },
        "domain": { "allOf": [{ "$ref": "#/$defs/singleLine" }, { "maxLength": 64 }] },
        "goal": { "$ref": "#/$defs/singleLine" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/singleLine" }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/singleLine" }
        }
      }
    }
  }
}
