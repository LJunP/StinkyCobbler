{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://stinkycobbler.dev/schemas/pack.schema.json",
  "type":"object",
  "required":["version","id","label","artifactTypes","roleExtensions","qualityRules","recommendedPlugins"],
  "properties":{
    "version":{"type":"integer","const":1},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},
    "label":{"type":"string","minLength":1},
    "artifactTypes":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "roleExtensions":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "qualityRules":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "recommendedPlugins":{"type":"array","uniqueItems":true,"items":{"type":"string"}}
  },
  "additionalProperties":false
}
