{
  "title": "TaskContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "contractId",
    "taskId",
    "domain",
    "goal",
    "globalAcceptanceCriteria",
    "scope",
    "createdAt",
    "status"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "contractId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "globalAcceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "taskId": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "taskAuthorityHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approvalRefs": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "hostSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reviewPolicy": {
      "enum": ["INDEPENDENT_REQUIRED", "SELF_REVIEW_AUDITED"]
    },
    "delegationBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxToolCalls", "expiresAt"],
      "properties": {
        "maxToolCalls": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "lifetimeAllocatedToolCalls": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "pendingLeaseAllocations": {
          "type": "object",
          "maxProperties": 128,
          "patternProperties": {
            "^lease-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/orchestration-contract.schema.json"
}
