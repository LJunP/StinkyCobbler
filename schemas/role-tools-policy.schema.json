{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/role-tools-policy.schema.json",
  "title": "Role Tools Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tools"],
  "properties": {
    "version": { "const": 1 },
    "tools": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,63}$": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
        }
      },
      "additionalProperties": false
    }
  }
}
