{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/artifact.schema.json",
  "title": "Stinky Cobbler Artifact",
  "type": "object",
  "required": ["id", "type", "version", "sensitivity", "status", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "type": {"enum": ["document", "report", "dataset", "plan", "design", "message", "code-change", "workflow-run", "decision-record", "media", "test-report", "evidence-pack"]},
    "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "version": {"type": "string", "minLength": 1},
    "schemaRef": {"type": "string"},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "status": {"enum": ["draft", "reviewed", "approved", "published", "revoked"]},
    "contentRef": {"type": "string"},
    "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reviewRefs": {"type": "array", "items": {"type": "string"}},
    "approvalRefs": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "required": ["taskId"],
      "properties": {
        "taskId": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "sourceRefs": {"type": "array", "items": {"type": "string"}},
        "toolRefs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
