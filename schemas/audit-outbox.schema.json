{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/audit-outbox.schema.json",
  "title": "Audit Outbox Aggregate",
  "oneOf": [
    {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/record" }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "recordsDirectory", "callsDirectory", "receiptsDirectory", "pendingDirectory"],
      "properties": {
        "version": { "const": 2 },
        "recordsDirectory": { "const": "audit-outbox/records" },
        "callsDirectory": { "const": "audit-outbox/calls" },
        "receiptsDirectory": { "const": "audit-outbox/receipts" },
        "pendingDirectory": { "const": "audit-outbox/pending" }
      }
    }
  ],
  "$defs": {
    "record": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "callId", "taskId", "role", "tool", "outcome", "receiptId", "stage", "createdAt", "attempts"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "callId": { "$ref": "#/$defs/id" },
      "taskId": { "$ref": "#/$defs/id" },
      "role": { "$ref": "#/$defs/text" },
      "tool": { "$ref": "#/$defs/text" },
      "leaseId": { "$ref": "#/$defs/id" },
      "taskAuthorityHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
      "capability": { "$ref": "#/$defs/text" },
      "operation": { "$ref": "#/$defs/text" },
      "reservationId": { "$ref": "#/$defs/id" },
      "reservationOrdinal": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
      "outcome": { "enum": ["unknown", "completed", "rejected", "failed"] },
      "receiptId": { "$ref": "#/$defs/id" },
      "stage": { "enum": ["prepared", "recovery-required", "committed"] },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
      },
      "attempts": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "errorCode": { "$ref": "#/$defs/errorCode" },
      "lastErrorCode": { "$ref": "#/$defs/errorCode" }
    }
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]+$" },
    "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }
  }
}
