{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/cancellation-fence.schema.json",
  "title": "Orchestration Cancellation Fence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "status", "requestedAt"],
  "properties": {
    "version": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "status": { "enum": ["CANCELLING", "CANCELLED"] },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "CANCELLED" } }, "required": ["status"] },
      "then": { "required": ["completedAt"] }
    },
    {
      "if": { "properties": { "status": { "const": "CANCELLING" } }, "required": ["status"] },
      "then": { "not": { "required": ["completedAt"] } }
    }
  ]
}
