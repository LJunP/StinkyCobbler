{
  "title": "OrchestrationRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runId",
    "contractRef",
    "status",
    "round",
    "budget",
    "subtasks",
    "artifacts",
    "reviews",
    "goalConsistency",
    "createdAt"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "contractRef": {
      "type": "string"
    },
    "creationRequestHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "supersedesRunRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "RUNNING",
        "DEGRADED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "ESCALATED"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRounds",
        "maxRetriesPerSubtask",
        "maxSubtaskTokens",
        "usedTokens"
      ],
      "properties": {
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxRetriesPerSubtask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "maxSubtaskTokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000000
        },
        "usedTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "subtasks": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "reviews": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "goalConsistency": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round",
          "passed",
          "note"
        ],
        "properties": {
          "round": {
            "type": "integer"
          },
          "passed": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 1024
          },
          "validatorReceiptIds": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
          },
          "artifactRefs": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
          },
          "engineVerifiedAt": {
            "type": "string"
          }
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "escalatedAt": {
      "type": "string"
    },
    "resumedAt": {
      "type": "string"
    },
    "resumeGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resumeRequestHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resumedBudgetAdjusted": {
      "type": "boolean"
    },
    "escalationReason": {
      "type": "string"
    },
    "failFast": {
      "type": "boolean"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/orchestration-run.schema.json"
}
