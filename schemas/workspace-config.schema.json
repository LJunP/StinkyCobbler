{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/workspace-config.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": ["version", "workspaceId", "root", "profile", "packs", "mode", "roles"],
      "properties": {
        "version": {"const": 1},
        "workspaceId": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "root": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "packs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "mode": {"enum": ["draft-first", "reviewed-workflow", "policy-governed", "advice-only"]},
        "allowLocalL0Exploration": {"type": "boolean"},
        "roles": {"type": "object", "additionalProperties": {"type": "object", "required": ["displayName"], "properties": {"displayName": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["version", "workspaceId", "root", "profile", "packs", "mode", "roles", "plugins"],
      "properties": {
        "version": {"const": 2},
        "workspaceId": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "root": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "packs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "mode": {"enum": ["draft-first", "reviewed-workflow", "policy-governed", "advice-only"]},
        "allowLocalL0Exploration": {"type": "boolean"},
        "roles": {"type": "object", "additionalProperties": {"type": "object", "required": ["displayName"], "properties": {"displayName": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "plugins": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "additionalProperties": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    }
  ]
}
