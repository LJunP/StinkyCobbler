{
  "title": "ReviewRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "reviewId",
    "runRef",
    "subtaskRef",
    "round",
    "decision",
    "criteriaResults",
    "defects",
    "score",
    "reason",
    "createdAt",
    "reviewedBy"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "runRef": {
      "type": "string"
    },
    "subtaskRef": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "decision": {
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "criteriaResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "passed",
          "note"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "passed": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "defects": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "problem",
          "suggestion"
        ],
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "validatorReceiptIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "createdAt": {
      "type": "string"
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tokensUsed": {
      "type": "integer",
      "minimum": 0
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "reviewIndependence": {
      "enum": ["INDEPENDENT", "SELF_REVIEW_NON_INDEPENDENT"]
    },
    "tokenAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "chargedTokens"],
      "properties": {
        "status": { "enum": ["ESTIMATED", "UNKNOWN", "PROVIDER_RECEIPT"] },
        "chargedTokens": { "type": "integer", "minimum": 0 },
        "providerReceiptRef": { "type": "string", "minLength": 1 }
      }
    },
    "sameSourceReview": {
      "type": "boolean"
    },
    "validatorEvidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["validator", "passed", "detail"],
        "properties": {
          "validator": { "type": "string" },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stinkycobbler.dev/schemas/orchestration-review.schema.json"
}
