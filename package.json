{
  "name": "stinky-cobbler",
  "version": "3.0.0-rc.1",
  "description": "Declarative AI agent toolkit package manager for Codex, Claude Code, Cursor, and ZCode; the frozen 2.x gate remains in the package.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LJunP/StinkyCobbler.git"
  },
  "homepage": "https://github.com/LJunP/StinkyCobbler#readme",
  "bugs": {
    "url": "https://github.com/LJunP/StinkyCobbler/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "resources",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "bin": {
    "stinky-cobbler": "./dist/cli.js",
    "stinky-cobbler-mcp": "./dist/mcp-server.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "lint": "npm run typecheck && npm run typecheck:tests && npm run lint:eslint && npm run lint:deps",
    "check:version": "node scripts/check-version.mjs",
    "prepack": "npm run build && npm run check:version",
    "dev": "tsx src/cli.ts",
    "dev:mcp": "tsx src/mcp-server.ts",
    "test:unit": "vitest run --project unit",
    "typecheck:tests": "node scripts/check-test-types.mjs",
    "lint:eslint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "lint:deps:baseline": "depcruise src --config .dependency-cruiser.cjs --output-type baseline > .dependency-cruiser-known-violations.json",
    "format": "prettier --write \"src/{core,hosts,io,app}/**/*.ts\"",
    "coverage": "vitest run --project unit --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "smol-toml": "^1.7.1",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "fflate": "0.8.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,mjs,cjs,js}": "eslint"
  }
}
